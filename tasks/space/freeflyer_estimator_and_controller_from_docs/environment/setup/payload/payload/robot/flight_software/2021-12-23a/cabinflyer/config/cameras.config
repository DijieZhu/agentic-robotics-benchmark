require "context"

-- bayer_enable: Set to true to enable publishing raw Bayer images (can
--   be converted to RGB). May incur significant I/O overhead.

-- bayer_throttle_ratio: Set to n to publish 1 raw Bayer image for
--   every n images grabbed. With n = 1, every image is
--   published. Larger n reduces I/O overhead.

navigation_camera = {
  width                = 1280,
  height               = 960,
  undistorted_width    = 3000,
  undistorted_height   = 1800,
  distortion_coeff     = robot_camera_calibrations.navigation_camera.distortion_coeff,
  intrinsic_matrix     = robot_camera_calibrations.navigation_camera.intrinsic_matrix,
  device               = "/dev/navigation_camera",
  gain                 = robot_camera_calibrations.navigation_camera.gain,
  exposure             = robot_camera_calibrations.navigation_camera.exposure,
  calibration_gain     = 105,
  calibration_exposure = 30,
  bayer_enable = false,
  bayer_throttle_ratio = 3
};

back_camera = {
  width=1280,
  height=960,
  undistorted_width=3000,
  undistorted_height=1800,
  distortion_coeff=robot_camera_calibrations.back_camera.distortion_coeff,
  intrinsic_matrix=robot_camera_calibrations.back_camera.intrinsic_matrix,
  device="/dev/back_camera",
  gain=            robot_camera_calibrations.back_camera.gain,
  exposure=        robot_camera_calibrations.back_camera.exposure,
  calibration_gain     = 105,
  calibration_exposure = 30,
  bayer_enable = false,
  bayer_throttle_ratio = 3
};

-- The haz and backdepth camera params below are ignored for the time being.
-- The distortion_coeff, etc, must be set in each bot's config file.
frontdepth_camera = {
  width                = 224,
  height               = 171,
  undistorted_width    = 250,
  undistorted_height   = 200,
  distortion_coeff     = robot_camera_calibrations.frontdepth_camera.distortion_coeff,
  intrinsic_matrix     = robot_camera_calibrations.frontdepth_camera.intrinsic_matrix,
  device               = "/dev/frontdepth_camera",
  gain                 = robot_camera_calibrations.frontdepth_camera.gain,
  exposure             = robot_camera_calibrations.frontdepth_camera.exposure,
  calibration_gain     = 105,
  calibration_exposure = 30
};

backdepth_camera = {
  width                = 224,
  height               = 171,
  undistorted_width    = 250,
  undistorted_height   = 200,
  distortion_coeff=robot_camera_calibrations.backdepth_camera.distortion_coeff,
  intrinsic_matrix=robot_camera_calibrations.backdepth_camera.intrinsic_matrix,
  device="/dev/backdepth_camera",
  gain=            robot_camera_calibrations.backdepth_camera.gain,
  exposure=        robot_camera_calibrations.backdepth_camera.exposure,
  calibration_gain     = 105,
  calibration_exposure = 30
};

imaging_camera = {
  width                = 1336,
  height               = 1002,
  undistorted_width    = 2000,
  undistorted_height   = 2000,
  distortion_coeff     = robot_camera_calibrations.imaging_camera.distortion_coeff,
  intrinsic_matrix     = robot_camera_calibrations.imaging_camera.intrinsic_matrix,
  device               = "/dev/imaging_camera",
  gain                 = robot_camera_calibrations.imaging_camera.gain,
  exposure             = robot_camera_calibrations.imaging_camera.exposure,
  calibration_gain     = 105,
  calibration_exposure = 30
};

-----------------------------------------------------
--  Depthsensor cameras support the following modes
-----------------------------------------------------
-- MODE_9_5FPS_2000
-- MODE_9_10FPS_1000
-- MODE_9_15FPS_700
-- MODE_9_25FPS_450
-- MODE_5_35FPS_600
-- MODE_5_45FPS_500
-----------------------------------------------------

depthsensor = {
  api_key = "",
  devices = {
    {
      name = "backdepth_camera",               -- frame
      topic = "perch",                  -- frame
      device = robot_backdepth_camera_device,  -- camera uuid ("" : automatic)
      exposure = 0,                     -- exposure time (0: automatic)
      mode = "MODE_9_5FPS_2000",        -- use case
      required = true                   -- is camera required
    },{
      name = "frontdepth_camera",                 -- frame
      topic = "haz",                    -- frame
      device = robot_frontdepth_camera_device,    -- camera uuid ("" : automatic)
      exposure = 0,                     -- exposure time (0: automatic)
      mode = "MODE_9_5FPS_2000",        -- use case
      required = true                   -- is camera required
    },{
      name = "test_cam",                -- special name
      topic = "test",                   -- frame
      device = "0005-4805-0050-1520",   -- camera uuid ("" : automatic)
      exposure = 0,                     -- exposure time (0: automatic)
      mode = "MODE_5_45FPS_500",        -- use case
      required = false                  -- is camera required
    }
  }
}
