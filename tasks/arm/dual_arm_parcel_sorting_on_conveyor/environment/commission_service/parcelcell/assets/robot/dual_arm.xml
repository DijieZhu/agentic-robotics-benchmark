    <map znear="0.01"/>
    <headlight ambient="0.4 0.4 0.42" diffuse="0.7 0.7 0.7"/>
  </visual>

  <default>
    <default class="drive_80nm">
      <joint damping="2.0" armature="0.05" frictionloss="0.3"/>
    </default>
    <default class="drive_36nm">
      <joint damping="1.0" armature="0.03" frictionloss="0.2"/>
    </default>
    <default class="arm_visual">
      <geom type="mesh" group="1" contype="0" conaffinity="0" mass="0" rgba="0.85 0.86 0.89 1"/>
    </default>
    <default class="arm_collision">
      <geom type="mesh" group="3" rgba="0.85 0.86 0.89 1"/>
    </default>
    <default class="base_collision">
      <geom type="box" group="3" mass="0" rgba="0 0 0 0"/>
