{
 "schema": "uwkit.viz.rotor_split/1",
 "conventions": {
  "frames": "prototype = native mesh frame of the thruster prototype (metres; the manifest pose T_B maps it to B); B = body FLU",
  "axis": "axis_B = unit vector along the site +x of the digest table = direction of the force on the body under positive (forward) thrust = from the propeller towards the nose cone (the 'front' of the thruster)",
  "spin_sign_forward": "sign of omega . axis_B for forward thrust (positive command / positive rotor speed); -1 = the rotor turns clockwise when seen from the nose cone (looking along -axis_B), +1 = counter-clockwise.  Visible spin = spin_sign_forward x sign(rotor speed).",
  "outflow": "forward thrust: water leaves through the rear lip (rear_lip_B_m, behind the propeller); reverse thrust: through the front lip around the nose cone (front_lip_B_m)",
  "what_rotates": "only the propeller solid (blades + hub; the motor rotor, shaft, shaft collar and the propeller screw are inside / not in the vehicle CAD); nose cone, nozzle (with its tail cone and rear vanes), stator base and screws are static.  See UWKIT_VIZ.md section 2.",
  "marker": "rotor_marker = the outer part of one blade, same geometry as the blade, drawn in a contrasting colour only to make the rotation readable on video (not a real paint scheme)"
 },
 "sources": {
  "geometry": "per-solid B-rep tessellation of the vehicle CAD (0.2 mm / 0.3 rad), decimated with quadric simplification; poses = parts manifest T_B; table = spec values <config>.thrusters",
  "spin": "three checks: blade pitch hand from face normals, Newtonian panel model of the spinning rotor, and the vendor rule 'a CW propeller gives forward thrust spinning clockwise seen from the nose cone'"
 },
